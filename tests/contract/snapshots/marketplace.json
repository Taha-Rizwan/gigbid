{
 "prompts": [],
 "resource_templates": [],
 "tools": {
  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
   },
   "description": "Create a proposal draft on the marketplace (nothing is sent, no Connects spent). Only call after the\n    human approved this exact text. dry_run=true returns exactly what would be created and its cost.",
   "input_schema": {
    "$defs": {
     "ProposalDraftIn": {
      "properties": {
       "bid_amount": {
        "exclusiveMinimum": 0,
        "maximum": 100000,
        "title": "Bid Amount",
        "type": "number"
       },
       "cover_letter": {
        "maxLength": 5000,
        "minLength": 40,
        "title": "Cover Letter",
        "type": "string"
       },
       "job_id": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Job Id",
        "type": "string"
       },
       "rate_type": {
        "enum": [
         "hourly",
         "fixed"
        ],
        "title": "Rate Type",
        "type": "string"
       },
       "screening_answers": {
        "items": {
         "maxLength": 2000,
         "type": "string"
        },
        "maxItems": 10,
        "title": "Screening Answers",
        "type": "array"
       }
      },
      "required": [
       "job_id",
       "cover_letter",
       "bid_amount",
       "rate_type"
      ],
      "title": "ProposalDraftIn",
      "type": "object"
     }
    },
    "properties": {
     "draft": {
      "$ref": "#/$defs/ProposalDraftIn"
     },
     "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
     }
    },
    "required": [
     "draft",
     "idempotency_key"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   },
   "output_schema": {
    "properties": {
     "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotent_replay": {
      "default": false,
      "title": "Idempotent Replay",
      "type": "boolean"
     },
     "marketplace": {
      "title": "Marketplace",
      "type": "string"
     },
     "ok": {
      "title": "Ok",
      "type": "boolean"
     },
     "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
     }
    },
    "required": [
     "ok",
     "dry_run",
     "marketplace",
     "result"
    ],
    "title": "WriteResult",
    "type": "object"
   }
  },
